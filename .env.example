# ── Google Sheets API ──────────────────────────────────────────
# Server-side: guest data, FAQ content
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_EMAIL=
GOOGLE_PRIVATE_KEY=
# Optional: override default sheet tab names (default: 'GUESTS')
GOOGLE_SHEET_TAB=

# ── Firebase Auth ──────────────────────────────────────────────
# Client-side: phone/SMS sign-in, Google OAuth, anonymous sessions
# Get from Firebase Console → Project Settings → General → Web apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Enable these in Firebase Console → Authentication → Sign-in method:
#   - Google (OAuth popup)
#   - Anonymous (name-only sign-in)
#   - Phone (SMS verification — requires paid plan or test phone numbers)
# Test phones: +1 555-555-0100 through +1 555-555-0103 (code: 123456)
# Add in Firebase → Auth → Sign-in method → Phone → Test phone numbers

# Server-side: verify Firebase ID tokens for /api/guest/:id PATCH
# Create a service account: Firebase Console → Project Settings → Service Accounts
# → Generate new private key. Use the values from the downloaded JSON.
# The server uses these to call firebase-admin.auth().verifyIdToken().
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-side: HMAC secret for the HttpOnly session cookie minted for the
# email-link sign-in flow. Generate with: openssl rand -hex 32
# Required in production. A random value is used in dev if unset.
SESSION_SECRET=

# ── EmailJS ────────────────────────────────────────────────────
# Client-side: contact form submissions only
# (Email-link sign-in is now handled by Firebase — no EmailJS config needed for auth.)
# Create account at emailjs.com → Email Services → Add Service
# Email Templates → Create Template → use {{message}}, {{from_email}}
VITE_EMAILJS_CONTACT_TEMPLATE_ID=

# ── reCAPTCHA ──────────────────────────────────────────────────
# Server-side: contact form spam protection (v3)
# Get site + secret keys from https://www.google.com/recaptcha/admin (v3, not v2)
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Resend (error alerts) ──────────────────────────────────────
# Server-side: email notification when client-side errors occur
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=
# Email address that receives the error alerts
ALERT_EMAIL=

# ── SMTP (deployment reports) ──────────────────────────────────
# Used by daily-report.mjs and preview-check.mjs
# Gmail app password (enable 2FA first, then generate at https://myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
# Who receives the reports (default: sera.belize@gmail.com)
REPORT_RECIPIENT=
# Status check recipient (default: REPORT_RECIPIENT)
STATUS_RECIPIENT=
# Screenshot recipient (default: REPORT_RECIPIENT)
SCREENSHOT_RECIPIENT=

# ── Site URLs ──────────────────────────────────────────────────
# Override defaults for status checks and reports
SITE_URL=https://abhayandrebecca.com
# CDN base for image checks (default: jsDelivr gh-cdn)
CDN_BASE=https://cdn.jsdelivr.net/gh/abhaysampath/wedding-website@main/public

# ── CI/CD ──────────────────────────────────────────────────────
# Vercel deploy token: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ── Development ────────────────────────────────────────────────
API_PORT=3001
