{
  "name": "wedding-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env scripts/dev-server.mjs & vite",
    "dev:api": "node --env-file=.env scripts/dev-server.mjs",
    "build": "node scripts/verify-build.mjs",
    "deploy": "node scripts/verify-build.mjs",
    "e2e": "node scripts/deploy-e2e.mjs",
    "e2e:local": "node scripts/deploy-e2e.mjs http://localhost:3000",
    "e2e:prod": "node scripts/deploy-e2e.mjs https://abhayandrebecca.com",
    "preview": "vite preview",
    "preview:check": "node scripts/preview-check.mjs",
    "sync": "node --env-file=.env scripts/sync-guests.mjs",
    "test": "vitest run",
    "test:full": "vitest run && npm run build",
    "test:local": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/dm-sans": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.1.0",
    "framer-motion": "^12.42.2",
    "googleapis": "^173.0.0",
    "lightningcss": "^1.32.0",
    "playwright": "^1.61.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "resend": "^6.17.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "nodemailer": "^9.0.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "protobufjs": "7.6.4",
    "tar": "^7.5.16",
    "glob": "^13.0.0",
    "node-domexception": "^2.0.0",
    "uuid": "^11.1.1"
  }
}
